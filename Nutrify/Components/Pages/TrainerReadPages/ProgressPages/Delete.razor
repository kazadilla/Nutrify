@page "/progresses/delete"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Progress</h2>
    <hr />
    @if (progress is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@progress.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Weight</dt>
            <dd class="col-sm-10">@progress.Weight</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Points</dt>
            <dd class="col-sm-10">@progress.Points</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DailyLogId</dt>
            <dd class="col-sm-10">@progress.DailyLogId</dd>
        </dl>
        <EditForm method="post" Model="progress" OnValidSubmit="DeleteProgress" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(progress is null)">Delete</button> |
            <a href="/progresses">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Progress? progress;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        progress = await context.Progress.FirstOrDefaultAsync(m => m.Id == Id);

        if (progress is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteProgress()
    {
        using var context = DbFactory.CreateDbContext();
        context.Progress.Remove(progress!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/progresses");
    }
}
