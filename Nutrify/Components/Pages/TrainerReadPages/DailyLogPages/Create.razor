@page "/dailylogs/create"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>DailyLog</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="DailyLog" OnValidSubmit="AddDailyLog" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3" hidden>
                <label for="date" class="form-label">Date:</label> 
                <InputDate id="date" @bind-Value="DailyLog.Date" class="form-control" /> 
                <ValidationMessage For="() => DailyLog.Date" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="totalcalories" class="form-label">Total Calories:</label> 
                <InputNumber id="totalcalories" @bind-Value="DailyLog.TotalCalories" class="form-control" /> 
                <ValidationMessage For="() => DailyLog.TotalCalories" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="servingsizelogged" class="form-label">Serving Size Logged:</label> 
                <InputNumber id="servingsizelogged" @bind-Value="DailyLog.ServingSizeLogged" class="form-control" /> 
                <ValidationMessage For="() => DailyLog.ServingSizeLogged" class="text-danger" /> 
            </div>        
            <div class="mb-3" hidden>
                <label for="userid" class="form-label">UserId:</label> 
                <InputNumber id="userid" @bind-Value="DailyLog.UserId" class="form-control" /> 
                <ValidationMessage For="() => DailyLog.UserId" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/dailylogs">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private DailyLog DailyLog { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDailyLog()
    {
        using var context = DbFactory.CreateDbContext();
        context.DailyLog.Add(DailyLog);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dailylogs");
    }
}
