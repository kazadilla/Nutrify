@page "/dailylogs/delete"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>DailyLog</h2>
    <hr />
    @if (dailylog is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Date</dt>
            <dd class="col-sm-10">@dailylog.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">TotalCalories</dt>
            <dd class="col-sm-10">@dailylog.TotalCalories</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ServingSizeLogged</dt>
            <dd class="col-sm-10">@dailylog.ServingSizeLogged</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UserId</dt>
            <dd class="col-sm-10">@dailylog.UserId</dd>
        </dl>
        <EditForm method="post" Model="dailylog" OnValidSubmit="DeleteDailyLog" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(dailylog is null)">Delete</button> |
            <a href="/dailylogs">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private DailyLog? dailylog;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        dailylog = await context.DailyLog.FirstOrDefaultAsync(m => m.Id == Id);

        if (dailylog is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteDailyLog()
    {
        using var context = DbFactory.CreateDbContext();
        context.DailyLog.Remove(dailylog!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/dailylogs");
    }
}
