@page "/progresses/edit"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Progress</h2>
<hr />
@if (Progress is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Progress" OnValidSubmit="UpdateProgress" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Progress.Id" value="@Progress.Id" />
                <div class="mb-3">
                    <label for="date" class="form-label">Date:</label>
                    <InputDate id="date" @bind-Value="Progress.Date" class="form-control" />
                    <ValidationMessage For="() => Progress.Date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="weight" class="form-label">Weight:</label>
                    <InputNumber id="weight" @bind-Value="Progress.Weight" class="form-control" />
                    <ValidationMessage For="() => Progress.Weight" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="points" class="form-label">Points:</label>
                    <InputNumber id="points" @bind-Value="Progress.Points" class="form-control" />
                    <ValidationMessage For="() => Progress.Points" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dailylogid" class="form-label">DailyLogId:</label>
                    <InputNumber id="dailylogid" @bind-Value="Progress.DailyLogId" class="form-control" />
                    <ValidationMessage For="() => Progress.DailyLogId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/progresses">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Progress? Progress { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Progress ??= await context.Progress.FirstOrDefaultAsync(m => m.Id == Id);

        if (Progress is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateProgress()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Progress!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ProgressExists(Progress!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/progresses");
    }

    private bool ProgressExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Progress.Any(e => e.Id == id);
    }
}
