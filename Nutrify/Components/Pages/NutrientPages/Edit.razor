@page "/nutrients/edit"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Nutrient</h2>
<hr />
@if (Nutrient is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Nutrient" OnValidSubmit="UpdateNutrient" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Nutrient.Id" value="@Nutrient.Id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Nutrient.Name" class="form-control" />
                    <ValidationMessage For="() => Nutrient.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="units" class="form-label">Units:</label>
                    <InputNumber id="units" @bind-Value="Nutrient.Units" class="form-control" />
                    <ValidationMessage For="() => Nutrient.Units" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/nutrients">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Nutrient? Nutrient { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Nutrient ??= await context.Nutrient.FirstOrDefaultAsync(m => m.Id == Id);

        if (Nutrient is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateNutrient()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Nutrient!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!NutrientExists(Nutrient!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/nutrients");
    }

    private bool NutrientExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Nutrient.Any(e => e.Id == id);
    }
}
