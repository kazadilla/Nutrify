@page "/nutrients"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.QuickGrid
@using Nutrify.Domain
@using Nutrify.Data
@implements IAsyncDisposable
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory

<PageTitle>Index</PageTitle>

<h1>Index</h1>

<p>
    <a href="nutrients/create">Create New</a>
</p>

<QuickGrid Class="table" Items="context.Nutrient">
    <PropertyColumn Property="nutrient => nutrient.Name" />
    <PropertyColumn Property="nutrient => nutrient.Units" />

    <TemplateColumn Context="nutrient">
        <a href="@($"nutrients/edit?id={nutrient.Id}")">Edit</a> |
        <a href="@($"nutrients/details?id={nutrient.Id}")">Details</a> |
        <a href="@($"nutrients/delete?id={nutrient.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

@code {
    private NutrifyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
