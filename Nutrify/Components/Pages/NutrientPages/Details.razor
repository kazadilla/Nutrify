@page "/nutrients/details"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Details</h1>

<div>
    <h2>Nutrient</h2>
    <hr />
    @if (nutrient is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@nutrient.Name</dd>
            <dt class="col-sm-2">Units</dt>
            <dd class="col-sm-10">@nutrient.Units</dd>
        </dl>
        <div>
            <a href="@($"/nutrients/edit?id={nutrient.Id}")">Edit</a> |
            <a href="@($"/nutrients")">Back to List</a>
        </div>
    }
</div>

@code {
    private Nutrient? nutrient;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        nutrient = await context.Nutrient.FirstOrDefaultAsync(m => m.Id == Id);

        if (nutrient is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }
}
