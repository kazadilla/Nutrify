@page "/nutrients/delete"
@using Microsoft.EntityFrameworkCore
@using Nutrify.Domain
@inject IDbContextFactory<Nutrify.Data.NutrifyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Nutrient</h2>
    <hr />
    @if (nutrient is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@nutrient.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Units</dt>
            <dd class="col-sm-10">@nutrient.Units</dd>
        </dl>
        <EditForm method="post" Model="nutrient" OnValidSubmit="DeleteNutrient" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(nutrient is null)">Delete</button> |
            <a href="/nutrients">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Nutrient? nutrient;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        nutrient = await context.Nutrient.FirstOrDefaultAsync(m => m.Id == Id);

        if (nutrient is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteNutrient()
    {
        using var context = DbFactory.CreateDbContext();
        context.Nutrient.Remove(nutrient!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/nutrients");
    }
}
